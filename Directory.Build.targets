<Project>
  <Target Name="VerifyTvAIrVersionConsistency"
          BeforeTargets="BeforeBuild"
          Condition="'$(MSBuildProjectName)' == 'TvAIr' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build\Verify-TvAIr-Version.ps1&quot;" />
  </Target>
</Project>
